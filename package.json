{
  "name": "rivanta-green-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Rivanta Green development environment. Application implementation is deferred beyond Phase 1.",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check:prototype": "node --check rivanta-cinematic-scroll/script.js",
    "check:environment": "node scripts/verify-environment.mjs",
    "playwright": "playwright-cli",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:check": "node --conditions=react-server --experimental-strip-types scripts/check-database.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.24",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
}
